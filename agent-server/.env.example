# 可使用 OpenAI 或兼容 Chat Completions API 的服务。
OPENAI_API_KEY=replace-with-your-server-key
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# DeepSeek 示例（将上面三行替换为下面三行）：
# OPENAI_API_KEY=你的 DeepSeek API Key
# OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.deepseek.com
# 用于保护 NAS 服务的访问口令。生产环境务必设置，并在 TripNote 设置中填写同一个值。
# AGENT_ACCESS_TOKEN=请替换为一段长随机口令
PORT=8787
# 可选：默认使用公开 Nominatim，生成后最多核验 6 个地点并写入坐标。
# PLACE_SEARCH_URL=https://nominatim.openstreetmap.org/search
